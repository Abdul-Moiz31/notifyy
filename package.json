{
  "name": "notify-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* run build",
    "dev:api": "pnpm --filter @notify-engine/api dev",
    "dev:dashboard": "pnpm --filter @notify-engine/dashboard dev",
    "deploy:api": "pnpm --filter @notify-engine/api deploy",
    "lint": "eslint . && pnpm --filter @notify-engine/dashboard run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^20.14.0",
    "eslint": "^9.15.0",
    "@eslint/js": "^9.15.0",
    "typescript-eslint": "^8.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "unrs-resolver", "workerd"]
  }
}
