# Use Supabase's connection pooler string, not the direct db.*.supabase.co host
# (the direct host is IPv6-only and unreachable from many networks/CI runners)
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM_EMAIL=notifications@example.com
LOG_LEVEL=info
WORKER_POLL_INTERVAL_MS=2000
WORKER_BATCH_SIZE=10

# dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# apps/api: verifies dashboard-issued Supabase session tokens (same project as above)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# dashboard: base URL of apps/api, called directly from the browser
NEXT_PUBLIC_API_URL=http://localhost:3000

# apps/api: CORS allowlist for /v1/dashboard/* (comma-separated origins), the dashboard's own origin
DASHBOARD_ORIGIN=http://localhost:3001
